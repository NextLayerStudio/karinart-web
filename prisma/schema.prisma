generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id                String   @id @default("singleton")
  inkProgramEnabled Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model AdminUser {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  name      String
  sessions  Session[]
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TattooAppointment {
  id                         String   @id @default(cuid())
  fullName                   String
  email                      String
  confirmAdult               Boolean
  placement                  String
  size                       String
  color                      String
  description                String
  references                 String[]
  imageUrl                   String?
  notes                      String?
  contactPreferenceEmail     Boolean  @default(true)
  contactPreferenceInstagram Boolean  @default(false)
  contactPreferencePhone     Boolean  @default(false)
  instagram                  String?
  phone                      String?
  agreeMarketing             Boolean  @default(true)
  agreePrivacy               Boolean
  allergies                  Boolean  @default(false)
  allergyDescription         String?
  healthIssues               Boolean  @default(false)
  healthIssueDescription     String?
  createdAt                  DateTime @default(now())
  appointmentDate            DateTime
  appointmentTime            String
  duration                   Float?
  status                     String   @default("pending")
  finalPrice                 Float?
  originalPrice              Float?
  voucherCode                String?
  voucherType                String?
}

model TattooImage {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String
  createdAt DateTime @default(now())
}

model BeautyImage {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String
  createdAt DateTime @default(now())
}

model BeautyAppointment {
  id              String   @id @default(cuid())
  fullName        String
  email           String
  phone           String?
  confirmAdult    Boolean
  agreePrivacy    Boolean
  agreeMarketing  Boolean  @default(false)
  serviceId       String
  serviceTitle    String
  servicePrice    Float?
  durationHours   Float
  notes           String?
  appointmentDate DateTime
  appointmentTime String
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  @@index([appointmentDate])
  @@index([status])
  @@index([serviceId])
}

model Marketing {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model GiveawayEntry {
  id             String   @id @default(cuid())
  fullName       String
  email          String   @unique
  instagram      String?
  agreeMarketing Boolean  @default(true)
  agreePrivacy   Boolean
  confirmAdult   Boolean
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([instagram])
}

model DayAvailability {
  id          String     @id @default(cuid())
  date        DateTime   @unique
  isAvailable Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  timeSlots   TimeSlot[]
}

model TimeSlot {
  id                String          @id @default(cuid())
  dayAvailabilityId String
  time              String
  isAvailable       Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  dayAvailability   DayAvailability @relation(fields: [dayAvailabilityId], references: [id], onDelete: Cascade)

  @@unique([dayAvailabilityId, time])
}

model DiscountCode {
  id            String            @id @default(cuid())
  code          String            @unique
  type          String
  value         Float
  maxUses       Int               @default(1)
  currentUses   Int               @default(0)
  expiresAt     DateTime?
  isActive      Boolean           @default(true)
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  availableFrom DateTime?
  availableTo   DateTime?
  uses          DiscountCodeUse[]

  @@index([code])
  @@index([isActive])
}

model DiscountCodeUse {
  id             String       @id @default(cuid())
  discountCodeId String
  appointmentId  String?
  customerEmail  String
  usedAt         DateTime     @default(now())
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)

  @@index([discountCodeId])
  @@index([customerEmail])
}

model GiftCard {
  id          String        @id @default(cuid())
  code        String        @unique
  amount      Float
  balance     Float
  maxUses     Int           @default(1)
  currentUses Int           @default(0)
  expiresAt   DateTime?
  isActive    Boolean       @default(true)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  uses        GiftCardUse[]

  @@index([code])
  @@index([isActive])
}

model GiftCardUse {
  id            String   @id @default(cuid())
  giftCardId    String
  appointmentId String?
  customerEmail String
  amountUsed    Float
  usedAt        DateTime @default(now())
  giftCard      GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
  @@index([customerEmail])
}

model GiftCardOrder {
  id            String   @id
  amount        Float
  recipientName String?
  email         String
  message       String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([status])
}

model FreeDesign {
  id          String   @id @default(cuid())
  imageUrl    String
  title       String
  description String?
  reserved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FlashDesign {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String
  price     Float
  reserved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                         String              @id @default(cuid())
  email                      String              @unique
  phone                      String
  fullName                   String
  password                   String
  confirmAdult               Boolean
  agreeDataProcessing        Boolean
  agreeMarketing             Boolean             @default(false)
  emailVerified              Boolean             @default(false)
  emailVerificationToken     String?             @unique
  emailVerificationExpiresAt DateTime?
  invitedById                String?
  isActive                   Boolean             @default(true)
  isTestAccount              Boolean             @default(false)
  adminNotes                 String?
  inkCredits                 Int                 @default(0)
  inkCreditsEarned           Int                 @default(0)
  inkCreditsSpent            Int                 @default(0)
  isVip                      Boolean             @default(false)
  vipAwardedAt               DateTime?
  vipLastActivityAt          DateTime?
  vipExpiryWarningSentAt     DateTime?
  birthday                   DateTime?
  loyaltyTier                Int                 @default(0)
  loyaltyCardEnabled         Boolean             @default(false)
  loyaltyVipFromCard         Boolean             @default(false)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  invitedBy                  Customer?           @relation("CustomerInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees                   Customer[]          @relation("CustomerInvites")
  sessions                   CustomerSession[]
  activationsAsInvitee       InviteeActivation[] @relation("ActivationInvitee")
  activationsAsInviter       InviteeActivation[] @relation("ActivationInviter")
  loyaltyTransactions        LoyaltyTransaction[]
  inkCreditTransactions      InkCreditTransaction[]

  @@index([emailVerificationToken])
  @@index([invitedById])
  @@index([inkCredits])
  @@index([loyaltyTier])
}

model LoyaltyTransaction {
  id              String   @id @default(cuid())
  customerId      String
  amountSpent     Float
  tiersUnlocked   String
  tiersBefore     Int
  tiersAfter      Int
  redundantAmount Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

model InkCreditTransaction {
  id          String   @id @default(cuid())
  customerId  String
  amount      Int
  type        String
  description String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

model InviteeActivation {
  id                String   @id @default(cuid())
  inviteeId         String   @unique
  inviterId         String
  amountSpent       Float
  inkCreditsAwarded Int      @default(100)
  notes             String?
  createdAt         DateTime @default(now())
  invitee           Customer @relation("ActivationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter           Customer @relation("ActivationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviteeId])
  @@index([inviterId])
  @@index([createdAt])
}

model CustomerSession {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model SiteAnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String
  eventType String
  path      String
  target    String?
  element   String?
  label     String?
  section   String?
  referrer  String?
  viewport  String?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([path])
  @@index([createdAt])
}

model BeautyServicePrice {
  serviceId     String   @id
  priceEUR      Float?
  durationHours Float
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}
